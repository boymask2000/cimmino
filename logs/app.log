        const quantita =
            parseInt(row.querySelector('.numBins').value) || 0;

        const binId =
            parseInt(row.querySelector('.binSelect').value);

        if (!binId)
            return;

        // cerca il bin selezionato
        const bin = binsList.find(b => b.id == binId);

        if (!bin)
            return;

        totaleLordo +=
            (bin.peso_lordo || 0) * quantita;

        totaleNetto +=
            (bin.peso_lordo-bin.tara || 0) * quantita;
    });

    // aggiorna campi
    document.querySelector('[name="peso_lordo"]').value =
        totaleLordo;

    document.querySelector('[name="peso_netto"]').value =
        totaleNetto;

    document.querySelector('[name="calo"]').value =
        totaleLordo - totaleNetto;
}

function addBin() {

    const container =
        document.getElementById("binsContainer");

    let options =
        `<option value="">Seleziona Bin</option>`;

    binsList.forEach(b => {

        options += `
            <option value="${b.id}">
                ${b.name}
            </option>`;
    });

    const html = `

    <div class="row mb-2 border p-2 bin-row">

        <div class="col-md-5">

        <input type="number"
            name="bins[${index}].numBins"
            class="form-control numBins"
            placeholder="Numero bins"
            min="1"
            required
            oninput="aggiornaCampi()">

        </div>

        <div class="col-md-5">

            <select name="bins[${index}].bin"
                    class="form-control binSelect"
                    onchange="aggiornaCampi()">

                ${options}

            </select>

        </div>
        
 

        <div class="col-md-2">

            <button type="button"
                    class="btn btn-danger"
                    onclick="removeRow(this)">
                X
            </button>

        </div>

    </div>

    container.insertAdjacentHTML("beforeend", html);

    index++;
}

function removeRow(button) {

    button.closest('.bin-row').remove();

    aggiornaCampi();
}

